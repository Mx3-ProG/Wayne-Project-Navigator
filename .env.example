# Supabase — client (exposed to the browser, VITE_ prefix required)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Supabase — server only, never expose to the client
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Resend — transactional email (login codes, client messages)
RESEND_API_KEY=

# Stripe — client (exposed to the browser, VITE_ prefix required, safe to expose)
VITE_STRIPE_PUBLISHABLE_KEY=

# Stripe — server only, never expose to the client
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Public app origin, used to build links (e.g. the payment page URL) sent in emails
PUBLIC_APP_URL=http://localhost:8080
